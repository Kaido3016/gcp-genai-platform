# Copy to .env and adjust. Nothing here is a real secret; GCP auth uses
# Application Default Credentials / a service account, never a key in this file.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- GCP -------------------------------------------------------------------
# Leave GCP_USE_LIVE_VERTEX_AI=false to run entirely locally against the
# mock AI backend and in-memory vector store (no GCP project needed).
GCP_USE_LIVE_VERTEX_AI=false
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GCP_DOCUMENTS_BUCKET=your-genai-platform-documents-bucket
GCP_VECTOR_INDEX_ID=
GCP_VECTOR_INDEX_ENDPOINT_ID=

# --- Generation --------------------------------------------------------------
GEN_MODEL_NAME=gemini-2.0-flash-001
GEN_TEMPERATURE=0.2
GEN_TOP_P=0.95
GEN_MAX_OUTPUT_TOKENS=1024
GEN_TIMEOUT_SECONDS=30
GEN_MAX_RETRIES=3
GEN_RETRY_BACKOFF_BASE_SECONDS=1.0

# --- Embeddings ----------------------------------------------------------------
EMBED_MODEL_NAME=text-embedding-005
EMBED_OUTPUT_DIMENSIONALITY=768
EMBED_BATCH_SIZE=16
EMBED_TIMEOUT_SECONDS=15
EMBED_MAX_RETRIES=3

# --- Retrieval -------------------------------------------------------------------
# NOTE: RETRIEVAL_SIMILARITY_THRESHOLD=0.15 is calibrated for the local
# mock embedding backend (see docs/RAG_DESIGN.md). Re-tune against real
# Vertex AI text-embedding-005 similarity scores before production use —
# real embeddings are far better separated and a 0.15 floor would be too
# permissive.
RETRIEVAL_TOP_K=8
RETRIEVAL_SIMILARITY_THRESHOLD=0.15
RETRIEVAL_MAX_CONTEXT_CHUNKS=5
RETRIEVAL_CHUNK_SIZE_TOKENS=400
RETRIEVAL_CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_DEDUPE_SIMILARITY_THRESHOLD=0.97

# --- Agent -------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=6
AGENT_TOOL_TIMEOUT_SECONDS=10
AGENT_MAX_TOOL_CALLS_PER_TURN=8

# --- Safety --------------------------------------------------------------------------
SAFETY_HARASSMENT_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
SAFETY_HATE_SPEECH_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
SAFETY_SEXUALLY_EXPLICIT_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
SAFETY_DANGEROUS_CONTENT_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE

# --- Upload ------------------------------------------------------------------------
UPLOAD_MAX_FILE_SIZE_MB=20
